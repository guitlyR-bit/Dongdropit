[Unit]
Description=OnionRANK (Tor leaderboard)
After=network.target tor.service

[Service]
User=onionrank
Group=onionrank
WorkingDirectory=/opt/onionrank
EnvironmentFile=/opt/onionrank/.env
ExecStart=/opt/onionrank/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8080 'onionrank:create_app()'
Restart=always
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onionrank/instance

[Install]
WantedBy=multi-user.target
