[Unit]
Description=OnionRANK – check pending BTCPay invoices
After=network.target

[Service]
Type=oneshot
User=onionrank
Group=onionrank
WorkingDirectory=/opt/onionrank
EnvironmentFile=/opt/onionrank/.env
ExecStart=/opt/onionrank/.venv/bin/flask --app onionrank reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onionrank/instance
